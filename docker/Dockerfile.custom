# syntax=docker/dockerfile:1.7

FROM node:16.19.1-bullseye AS build

WORKDIR /src

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npx gulp deploy

FROM nginx:1.23-alpine

LABEL org.opencontainers.image.source="https://github.com/Astler/taiga-front"
LABEL org.opencontainers.image.description="PressF customized Taiga frontend"

COPY docker/default.conf /etc/nginx/conf.d/default.conf
COPY docker/conf.json.template /usr/share/nginx/html/conf.json.template
COPY docker/config_env_subst.sh /docker-entrypoint.d/30_config_env_subst.sh
COPY --from=build /src/dist/ /usr/share/nginx/html/

RUN apk add --no-cache bash \
    && sed -i 's/\r$//' /docker-entrypoint.d/30_config_env_subst.sh \
    && chmod +x /docker-entrypoint.d/30_config_env_subst.sh

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://127.0.0.1/ || exit 1
