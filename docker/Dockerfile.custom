# syntax=docker/dockerfile:1.7

FROM node:16.19.1-bullseye AS build

WORKDIR /src

ENV NPM_CONFIG_AUDIT=false \
    NPM_CONFIG_FUND=false \
    NPM_CONFIG_UPDATE_NOTIFIER=false \
    GIT_TERMINAL_PROMPT=0

RUN git config --global --add url."https://github.com/".insteadOf "ssh://git@github.com/" \
    && git config --global --add url."https://github.com/".insteadOf "git@github.com:" \
    && git config --global --add url."https://github.com/".insteadOf "https://git@github.com/"

COPY package.json package-lock.json ./
RUN --mount=type=cache,id=taiga-front-npm,target=/root/.npm,sharing=locked \
    set -eux; \
    echo "[build:npm] start $(date -u +%FT%TZ)"; \
    npm ci --prefer-offline --foreground-scripts --timing; \
    echo "[build:npm] done $(date -u +%FT%TZ)"

COPY . .
RUN set -eux; \
    echo "[build:gulp] start $(date -u +%FT%TZ)"; \
    ./node_modules/.bin/gulp deploy; \
    echo "[build:gulp] done $(date -u +%FT%TZ)"

FROM nginx:1.23-alpine

LABEL org.opencontainers.image.source="https://github.com/Astler/taiga-front"
LABEL org.opencontainers.image.description="PressF customized Taiga frontend"

COPY docker/default.conf /etc/nginx/conf.d/default.conf
COPY docker/conf.json.template /usr/share/nginx/html/conf.json.template
COPY docker/config_env_subst.sh /docker-entrypoint.d/30_config_env_subst.sh
COPY --from=build /src/dist/ /usr/share/nginx/html/

RUN apk add --no-cache bash \
    && sed -i 's/\r$//' /docker-entrypoint.d/30_config_env_subst.sh \
    && chmod +x /docker-entrypoint.d/30_config_env_subst.sh

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://127.0.0.1/ || exit 1
