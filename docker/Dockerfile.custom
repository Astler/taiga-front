# syntax=docker/dockerfile:1.7

FROM node:16.19.1-bullseye-slim AS build

WORKDIR /src

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        git \
        g++ \
        make \
        python3 \
    && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npx gulp deploy

FROM nginx:1.23-alpine

LABEL org.opencontainers.image.source="https://github.com/Astler/taiga-front"
LABEL org.opencontainers.image.description="PressF customized Taiga frontend"

COPY docker/default.conf /etc/nginx/conf.d/default.conf
COPY docker/conf.json.template /usr/share/nginx/html/conf.json.template
COPY docker/config_env_subst.sh /docker-entrypoint.d/30_config_env_subst.sh
COPY --from=build /src/dist/ /usr/share/nginx/html/

RUN chmod +x /docker-entrypoint.d/30_config_env_subst.sh

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://127.0.0.1/ || exit 1
